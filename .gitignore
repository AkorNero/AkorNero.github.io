.terraform/
*:Zone.Identifier
.env
my_photos

# Terraform: local state and machine-specific settings.
# .terraform.lock.hcl is committed so every run uses the same provider versions.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
*.tfvars
# The state bucket's name contains the AWS account ID; backend.hcl.example shows the format.
IaC/backend.hcl
